config {
    bpm: 75
    meter: 8/8

    init right_hand with (
        synth: 0,
        pattern: [
            C#5, B4, D#5, C#5, B4, B4, A#4, A#4,
            A#4, B4, C#5, [B4, D#5],
            [C#5, E#5], [D#5, F#5], [E#5, G#5], [F#5, A#5],
            A#4, B4, C#5, [B4, D#5],
            [C#5, E#5], [D#5, F#5], [E#5, G#5], [F#5, A#5],
            A#4, B4, C#5, [B4, D#5],
            [C#5, E#5], [D#5, F#5], [E#5, G#5], [F#5, A#5]
        ]
    )

    init left_hand with (
        synth: 0,
        pattern: [
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest,
            [F#3, A#3, C#4], rest
        ]
    )
}

main {
    1$right_hand
    2$left_hand
}
